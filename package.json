{
  "name": "ceulen-dsh",
  "version": "0.2.2",
  "release": {
    "line": "stable",
    "distTag": "stable"
  },
  "description": "Ceulen for DeepSeek Harness: router/model tooling, memory, rules, review, web, A2A and an upstream release watcher in one bundle.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./modules/*": {
      "types": "./lib/modules/*/index.d.ts",
      "default": "./lib/modules/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "parity.json",
    "upstream.lock.json",
    "vendor.manifest.json",
    "skills",
    "scripts",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.5"
  },
  "dshTui": "0.18.0",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run build && npm run typecheck:strict && npm run typecheck:test && npm run test:cov && node scripts/check-bundle.mjs && node scripts/check-pack.mjs && node scripts/ceulen-sync.mjs parity --check",
    "bench:search": "node scripts/bench-search.mjs",
    "evo": "node scripts/evo-distill.mjs",
    "evo:report": "node scripts/evo-report.mjs",
    "evo:drain": "node scripts/evo-report.mjs --drain",
    "evo:promote": "node scripts/evo-report.mjs --promote",
    "sync": "node scripts/ceulen-sync.mjs",
    "parity": "node scripts/ceulen-sync.mjs parity",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:cov": "vitest run --coverage",
    "typecheck:strict": "node scripts/typecheck-strict.mjs",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^3.2.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
